    function initModalTabs() {
        const tabsContainer = document.getElementById('categoryTabs');
        tabsContainer.innerHTML = Object.keys(accountDatabase).map(cat => `
            <button class="tab-btn ${cat === currentCategory ? 'active' : ''}" onclick="switchCategory('${cat}')">${cat}</button>
        `).join('');
        renderCategoryItems(currentCategory);
    }

    function switchCategory(cat) {
        currentCategory = cat;
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.toggle('active', btn.innerText === cat);
        });
        renderCategoryItems(cat);
    }

    function renderCategoryItems(cat) {
        const tbody = document.getElementById('accountTableBody');
        const items = accountDatabase[cat] || [];

        tbody.innerHTML = items.map(item => `
            <tr onclick="selectAccount('${item.name}', '${item.side}')">
                <td style="color:var(--text-sub); font-family:monospace;">${item.code}</td>
                <td>${item.name}</td>
                <td>
                    <span class="side-badge ${item.side === '1' ? 'side-debit' : 'side-credit'}">
                        ${item.side === '1' ? '借方' : '貸方'}
                    </span>
                </td>
            </tr>
        `).join('');
    }

    function openModal(btnElement) {
        activeRowBtn = btnElement;
        document.getElementById('accountModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('accountModal').style.display = 'none';
        activeRowBtn = null;
    }

    function selectAccount(name, defaultSideCode) {
        if (activeRowBtn) {
            activeRowBtn.querySelector('.acc-name').innerText = name;
            activeRowBtn.dataset.account = name;

            const tr = activeRowBtn.closest('tr');
            const sideSelect = tr.querySelector('.side-select');
            if (sideSelect) {
                sideSelect.value = (defaultSideCode === "1") ? '借' : '貸';
            }
            calculateTotal();
        }
        closeModal();
    }

    function addRow(defaultSide = '借', accountName = '現金', amountValue = '') {
        const tbody = document.getElementById('entryRows');
        const tr = document.createElement('tr');

        tr.innerHTML = `
            <td>
                <select onchange="calculateTotal()" class="side-select" style="width: 100%;">
                    <option value="借" ${defaultSide === '借' ? 'selected' : ''}>借 (Debit)</option>
                    <option value="貸" ${defaultSide === '貸' ? 'selected' : ''}>貸 (Credit)</option>
                </select>
            </td>
            <td>
                <button type="button" class="btn-select-account" data-account="${accountName}" onclick="openModal(this)">
                    <span class="acc-name">${accountName}</span>
                    <span style="font-size:0.7rem; color:var(--text-sub);">🔍</span>
                </button>
            </td>
            <td>
                <input type="number" class="amount-input" placeholder="金額" min="0" value="${amountValue}" oninput="calculateTotal()" style="width: 100%;">
            </td>
            <td class="text-center">
                <button class="btn-danger-ghost" onclick="removeRow(this)">✕</button>
            </td>
        `;

        tbody.appendChild(tr);
        calculateTotal();
    }

    function removeRow(btn) {
        btn.closest('tr').remove();
        calculateTotal();
    }

    function calculateTotal() {
        let totalDebit = 0;
        let totalCredit = 0;

        const rows = document.querySelectorAll('#entryRows tr');
        rows.forEach(row => {
            const side = row.querySelector('.side-select').value;
            const amount = parseFloat(row.querySelector('.amount-input').value) || 0;

            if (side === '借') totalDebit += amount;
            else totalCredit += amount;
        });

        document.getElementById('totalDebit').innerText = totalDebit.toLocaleString();
        document.getElementById('totalCredit').innerText = totalCredit.toLocaleString();

        const statusEl = document.getElementById('balanceStatus');
        if (totalDebit > 0 && totalDebit === totalCredit) {
            statusEl.innerText = "✓ 平衡";
            statusEl.className = "balanced";
        } else {
            statusEl.innerText = "✕ 未平衡";
            statusEl.className = "unbalanced";
        }
    }

    function resetForm() {
        editingVoucherId = null;
        document.getElementById('formTitle').innerText = '📑 會計傳票登錄';
        document.getElementById('btnSave').innerText = '✓ 儲存傳票 (加入清單)';
        document.getElementById('btnCancelEdit').style.display = 'none';
        document.getElementById('voucherSummary').value = '';
        document.getElementById('entryRows').innerHTML = '';
        addRow('借');
        addRow('貸');
    }

    function saveVoucher() {
        const date = document.getElementById('voucherDate').value.trim();
        const summary = document.getElementById('voucherSummary').value.trim();
        const rows = document.querySelectorAll('#entryRows tr');

        let totalDebit = 0;
        let totalCredit = 0;
        let entries = [];

        rows.forEach(row => {
            const side = row.querySelector('.side-select').value;
            const accountBtn = row.querySelector('.btn-select-account');
            const account = accountBtn ? accountBtn.dataset.account : '';
            const amount = parseFloat(row.querySelector('.amount-input').value) || 0;

            if (amount > 0 && account) {
                entries.push({ side, account, amount });
                if (side === '借') totalDebit += amount;
                else totalCredit += amount;
            }
        });

        if (entries.length === 0) {
            alert('請至少輸入一筆有效的科目與金額！');
            return;
        }

        if (totalDebit !== totalCredit) {
            alert('借貸金額不相等，無法儲存傳票！');
            return;
        }

        // 自動排序：借方在上，貸方在下
        entries.sort((a, b) => {
            if (a.side === '借' && b.side === '貸') return -1;
            if (a.side === '貸' && b.side === '借') return 1;
            return 0;
        });

        if (editingVoucherId !== null) {
            const index = savedVouchers.findIndex(v => v.id === editingVoucherId);
            if (index !== -1) {
                savedVouchers[index] = {
                    id: editingVoucherId,
                    date: date || '未填寫日期',
                    summary: summary || '無摘要',
                    entries: entries,
                    total: totalDebit
                };
            }
        } else {
            savedVouchers.push({
                id: Date.now(),
                date: date || '未填寫日期',
                summary: summary || '無摘要',
                entries: entries,
                total: totalDebit
            });
        }

        renderVouchers();
        resetForm();
    }

    function editVoucher(id) {
        const voucher = savedVouchers.find(v => v.id === id);
        if (!voucher) return;

        editingVoucherId = id;
        document.getElementById('formTitle').innerText = '✏️ 編輯會計傳票';
        document.getElementById('btnSave').innerText = '💾 更新傳票內容';
        document.getElementById('btnCancelEdit').style.display = 'inline-block';

        document.getElementById('voucherDate').value = voucher.date;
        document.getElementById('voucherSummary').value = voucher.summary;

        const tbody = document.getElementById('entryRows');
        tbody.innerHTML = '';
        voucher.entries.forEach(e => {
            addRow(e.side, e.account, e.amount);
        });

        document.getElementById('inputCard').scrollIntoView({ behavior: 'smooth' });
    }

    function cancelEdit() {
        resetForm();
    }

    function moveVoucher(index, direction) {
        const targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= savedVouchers.length) return;

        const temp = savedVouchers[index];
        savedVouchers[index] = savedVouchers[targetIndex];
        savedVouchers[targetIndex] = temp;

        renderVouchers();
    }

    function renderVouchers() {
        const container = document.getElementById('voucherList');
        if (savedVouchers.length === 0) {
            container.innerHTML = '<p style="color: var(--text-sub); text-align: center; margin: 12px 0;">尚未新增任何傳票。</p>';
            return;
        }

        container.innerHTML = savedVouchers.map((v, index) => {
            let rowsHtml = v.entries.map(e => {
                const isCredit = e.side === '貸';
                const indentClass = isCredit ? 'credit-indent' : 'debit-style';
                const accountDisplay = isCredit ? `貸：${e.account}` : `借：${e.account}`;
                
                return `
                    <tr>
                        <td class="${indentClass}">${accountDisplay}</td>
                        <td class="text-right" style="font-weight:600;">${!isCredit ? '$' + e.amount.toLocaleString() : ''}</td>
                        <td class="text-right" style="font-weight:600;">${isCredit ? '$' + e.amount.toLocaleString() : ''}</td>
                    </tr>
                `;
            }).join('');

            return `
                <div class="voucher-card">
                    <div class="voucher-header">
                        <span><strong>#${index + 1}</strong> | ${v.date} | ${v.summary}</span>
                        <div class="voucher-actions">
                            <button class="btn-action-ghost" onclick="moveVoucher(${index}, -1)" ${index === 0 ? 'disabled style="opacity:0.3;cursor:default;"' : ''}>⬆ 上移</button>
                            <button class="btn-action-ghost" onclick="moveVoucher(${index}, 1)" ${index === savedVouchers.length - 1 ? 'disabled style="opacity:0.3;cursor:default;"' : ''}>⬇ 下移</button>
                            <button class="btn-action-ghost" style="color:var(--primary);" onclick="editVoucher(${v.id})">✏️ 編輯</button>
                            <button class="btn-danger-ghost" onclick="deleteVoucher(${v.id})">刪除</button>
                        </div>
                    </div>
                    <table class="entry-table voucher-table">
                        <thead>
                            <tr>
                                <th>會計項目</th>
                                <th style="width: 100px;" class="text-right">借方金額</th>
                                <th style="width: 100px;" class="text-right">貸方金額</th>
                            </tr>
                        </thead>
                        <tbody>${rowsHtml}</tbody>
                        <tfoot>
                            <tr style="font-weight: bold; background: #f8fafc; border-top:1px solid #e2e8f0;">
                                <td class="text-right" style="padding:4px 0;">合計</td>
                                <td class="text-right" style="padding:4px 0;" colspan="2">$${v.total.toLocaleString()}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            `;
        }).join('');
    }

    function deleteVoucher(id) {
        if (editingVoucherId === id) {
            cancelEdit();
        }
        savedVouchers = savedVouchers.filter(v => v.id !== id);
        renderVouchers();
    }

    function clearAllVouchers() {
        if (confirm('確定要清空所有已儲存的傳票嗎？')) {
            savedVouchers = [];
            resetForm();
            renderVouchers();
        }
    }
</script>

</body>
</html>

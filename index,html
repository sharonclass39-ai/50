<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>會計傳票自主練習系統</title>
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --border-focus: #818cf8;
            --text-main: #0f172a;
            --text-sub: #64748b;
            --debit-color: #0d9488;
            --debit-bg: #f0fdf4;
            --credit-color: #d97706;
            --credit-bg: #fffbeb;
            --danger: #ef4444;
            --success: #10b981;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }

        * { box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Microsoft JhengHei", sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 12px;
            font-size: 14px;
            line-height: 1.4;
        }

        .container {
            max-width: 860px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .card {
            background: var(--card-bg);
            padding: 14px 16px;
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1.5px solid #f1f5f9;
        }

        h2, h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-sub);
            letter-spacing: 0.03em;
        }

        input, select {
            padding: 6px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.875rem;
            outline: none;
            transition: all 0.15s ease;
            background-color: #f8fafc;
        }

        input:focus, select:focus {
            background-color: #fff;
            border-color: var(--border-focus);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        /* 桌面版表格樣式 */
        .entry-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .entry-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 4px;
        }

        .entry-table th {
            background-color: #f8fafc;
            color: var(--text-sub);
            font-weight: 600;
            font-size: 0.78rem;
            padding: 6px 10px;
            text-align: left;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .entry-table td {
            padding: 6px 8px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        /* 手機 RWD 卡片化輸入排版 */
        @media (max-width: 640px) {
            body { padding: 8px; }
            .card { padding: 12px; }
            .form-row { flex-direction: column; gap: 8px; }
            
            .entry-table, .entry-table thead, .entry-table tbody, .entry-table th, .entry-table td, .entry-table tr {
                display: block;
            }
            
            .entry-table thead { display: none; }

            .entry-table tr {
                background: #f8fafc;
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 8px 10px;
                margin-bottom: 8px;
                position: relative;
                display: grid;
                grid-template-columns: 85px 1fr;
                gap: 6px;
                align-items: center;
            }

            .entry-table td {
                padding: 0;
                border: none;
            }

            .entry-table td:nth-child(1) { grid-column: 1; }
            .entry-table td:nth-child(2) { grid-column: 2; }
            .entry-table td:nth-child(3) { grid-column: 1 / -1; }
            .entry-table td:nth-child(4) { 
                position: absolute; 
                top: 6px; 
                right: 6px; 
            }

            /* 手機版歷史傳票清單優化 */
            .voucher-table, .voucher-table thead, .voucher-table tbody, .voucher-table tr, .voucher-table td {
                display: block;
            }
            .voucher-table thead { display: none; }
            .voucher-table tr {
                padding: 6px 0;
                border-bottom: 1px dashed #f1f5f9;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .voucher-table td {
                padding: 2px 0;
                border: none;
            }
        }

        /* 貸方縮排關鍵樣式 */
        .credit-indent {
            padding-left: 2em !important;
            color: var(--credit-color);
            font-weight: 600;
        }

        .debit-style {
            color: var(--debit-color);
            font-weight: 600;
        }

        .btn {
            cursor: pointer;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 8px 14px;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            touch-action: manipulation;
        }

        .btn:hover { background-color: var(--primary-hover); }
        .btn:active { transform: scale(0.98); }

        .btn-select-account {
            background-color: #fff;
            color: var(--text-main);
            border: 1px solid var(--border);
            width: 100%;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.875rem;
        }

        .btn-secondary {
            background-color: #f1f5f9;
            color: var(--text-main);
            border: 1px solid var(--border);
            box-shadow: none;
        }

        .btn-action-ghost {
            background: transparent;
            color: var(--text-sub);
            border: 1px solid var(--border);
            padding: 2px 6px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.15s;
        }
        .btn-action-ghost:hover {
            background: #e2e8f0;
            color: var(--text-main);
        }

        .btn-danger-ghost {
            background: transparent;
            color: var(--danger);
            border: none;
            padding: 4px 8px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
        }

        .btn-sm { padding: 5px 10px; font-size: 0.78rem; }
        .btn-block { width: 100%; }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid var(--border);
            margin-top: 10px;
            font-size: 0.82rem;
            font-weight: 600;
        }

        .balanced { color: var(--success); }
        .unbalanced { color: var(--danger); }

        .voucher-card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 10px;
            background: #fff;
            box-shadow: var(--shadow-sm);
        }

        .voucher-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px dashed var(--border);
            padding-bottom: 6px;
            margin-bottom: 6px;
            font-size: 0.8rem;
            color: var(--text-sub);
            flex-wrap: wrap;
            gap: 6px;
        }

        .voucher-actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .text-right { text-align: right; }
        .text-center { text-align: center; }

        /* Modal 現代化視窗 */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: flex-end;
            z-index: 1000;
        }

        @media (min-width: 641px) {
            .modal-overlay { align-items: center; }
        }

        .modal-win {
            background: #ffffff;
            border-radius: 16px 16px 0 0;
            width: 100%;
            max-width: 600px;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 85vh;
        }

        @media (min-width: 641px) {
            .modal-win { border-radius: 12px; max-height: 80vh; }
        }

        .modal-title-bar {
            padding: 12px 16px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .category-tabs {
            display: flex;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
            padding: 4px 8px 0 8px;
            gap: 2px;
            #overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .tab-btn {
            padding: 8px 12px;
            font-size: 0.8rem;
            border: 1px solid transparent;
            border-bottom: none;
            background: transparent;
            color: var(--text-sub);
            cursor: pointer;
            border-radius: 6px 6px 0 0;
            font-weight: 600;
            white-space: nowrap;
        }

        .tab-btn.active {
            background: #ffffff;
            color: var(--primary);
            border-color: var(--border);
            border-bottom-color: #ffffff;
        }

        .account-grid-container {
            overflow-y: auto;
            flex-grow: 1;
            -webkit-overflow-scrolling: touch;
        }

        .account-grid {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .account-grid th, .account-grid td {
            padding: 10px 14px;
            border-bottom: 1px solid #f1f5f9;
        }

        .account-grid th {
            background: #f8fafc;
            color: var(--text-sub);
            font-size: 0.75rem;
            position: sticky;
            top: 0;
            text-align: left;
        }

        .side-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.72rem;
            font-weight: 600;
        }
        .side-debit { background: var(--debit-bg); color: var(--debit-color); }
        .side-credit { background: var(--credit-bg); color: var(--credit-color); }
    </style>
</head>
<body>

<div class="container">
    <!-- 傳票輸入區 -->
    <div class="card" id="inputCard">
        <div class="card-header">
            <h2 id="formTitle">📑 會計傳票登錄</h2>
            <span style="font-size:0.75rem; color:var(--text-sub);">RWD 手機優化版</span>
        </div>
        
        <div class="form-row">
            <div class="form-group">
                <label>日期</label>
                <input type="text" id="voucherDate" value="102/10/02">
            </div>
            <div class="form-group" style="flex-grow: 1;">
                <label>交易摘要</label>
                <input type="text" id="voucherSummary" placeholder="例如：向嘉南商店進貨">
            </div>
        </div>

        <div class="entry-table-wrap">
            <table class="entry-table">
                <thead>
                    <tr>
                        <th style="width: 110px;">借 / 貸</th>
                        <th>會計項目（點擊選擇）</th>
                        <th style="width: 140px;">金額</th>
                        <th style="width: 40px;" class="text-center">操作</th>
                    </tr>
                </thead>
                <tbody id="entryRows">
                    <!-- 動態分錄 -->
                </tbody>
            </table>
        </div>

        <div style="margin-top: 10px; display: flex; gap: 8px;">
            <button class="btn btn-secondary btn-sm" style="flex:1;" onclick="addRow('借')">＋ 借方列</button>
            <button class="btn btn-secondary btn-sm" style="flex:1;" onclick="addRow('貸')">＋ 貸方列</button>
        </div>

        <div class="status-bar">
            <div>
                借: $<span id="totalDebit">0</span> | 貸: $<span id="totalCredit">0</span>
            </div>
            <div id="balanceStatus" class="unbalanced">✕ 借貸未平衡</div>
        </div>

        <div style="margin-top: 12px; display: flex; gap: 8px;">
            <button class="btn btn-block" id="btnSave" onclick="saveVoucher()">✓ 儲存傳票 (加入清單)</button>
            <button class="btn btn-secondary" id="btnCancelEdit" style="display: none;" onclick="cancelEdit()">取消編輯</button>
        </div>
    </div>

    <!-- 歷史傳票清單 -->
    <div class="card">
        <div class="card-header">
            <h3>📋 已完成傳票總覽</h3>
            <button class="btn-danger-ghost btn-sm" onclick="clearAllVouchers()">清空全部</button>
        </div>
        <div id="voucherList">
            <p style="color: var(--text-sub); text-align: center; margin: 12px 0;">尚未新增任何傳票。</p>
        </div>
    </div>
</div>

<!-- 會計項目 Modal -->
<div class="modal-overlay" id="accountModal">
    <div class="modal-win">
        <div class="modal-title-bar">
            <span>🔍 選擇會計項目</span>
            <button class="btn-danger-ghost" onclick="closeModal()">✕ 關閉</button>
        </div>
        <div class="category-tabs" id="categoryTabs"></div>
        <div class="account-grid-container">
            <table class="account-grid">
                <thead>
                    <tr>
                        <th style="width: 25%;">編號</th>
                        <th>項目名稱</th>
                        <th style="width: 20%;">方向</th>
                    </tr>
                </thead>
                <tbody id="accountTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

